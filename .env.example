# AI无人值守工厂智能告警与自动处置平台 V1.0
# 系统环境与阿里云外呼配置模板

# 运行环境
APP_ENV=production
BACKEND_PORT=8000
FRONTEND_PORT=3000
DATABASE_URL=sqlite:///./data/factory.db

# 呼叫服务通道选择：aliyun(阿里云真实外呼) 或 mock(模拟测试外呼)
# 在现场有可用阿里云凭证时设为 aliyun；在无凭证或离线演示时自动/手动切为 mock
CALL_PROVIDER=mock

# ----------------- 阿里云语音服务 (Dyvmsapi) 配置 -----------------
# 阿里云账号 AccessKey ID
ALIBABA_CLOUD_ACCESS_KEY_ID=LTAI5tYourAccessKeyIdSample

# 阿里云账号 AccessKey Secret
ALIBABA_CLOUD_ACCESS_KEY_SECRET=YourAccessKeySecretSampleString

# 外呼主叫显号 (公网真实号码或阿里云专有显号，若未申请可留空使用默认公共池)
CALL_CALLED_SHOW_NUMBER=

# 语音通知 TTS 模板代号 (在阿里云语音服务控制台审核通过的文本转语音模板 Code，如 TTS_12345678)
TTS_CODE=TTS_2026100301

# 呼叫未接听判定超时时间 (秒)，超时后状态机自动触发升级机制拨打第二联系人
CALL_TIMEOUT_SECONDS=25

# ----------------- 现场演示人员手机号预设 -----------------
# 第一联系人 (一线值班工程师，发生报警时首要呼叫)
DEMO_PRIMARY_CONTACT_NAME=张工
DEMO_PRIMARY_CONTACT_PHONE=13800000001

# 第二联系人 (车间值班主管，第一联系人超时未接听时升级呼叫)
DEMO_SECONDARY_CONTACT_NAME=李主管
DEMO_SECONDARY_CONTACT_PHONE=13900000002

# ----------------- AI 异步分析服务配置 -----------------
# AI 引擎类型：rule_expert (工业机理专家推理模型，无需外网) 或 llm (大模型，需配置 API KEY)
AI_PROVIDER=rule_expert
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL_NAME=gpt-4o-mini
